{
  "permissions": {
    "allow": [
      "Edit(/.claude/skills/code-review/**)",
      "Edit(/.claude/skills/refactor/**)",
      "Edit(/.claude/skills/release/**)",
      "Edit(/.claude/skills/test/**)",
      "Edit(/.claude/skills/debug/**)",
      "Edit(/.claude/skills/frontend-design/**)",
      "Edit(/.claude/skills/api-design/**)",
      "Edit(/.claude/skills/error-handling/**)",
      "Edit(/.claude/skills/performance/**)",
      "Edit(/.claude/skills/database/**)",
      "Edit(/.claude/skills/git-workflow/**)",
      "Edit(/.claude/skills/logging/**)",
      "Edit(/.claude/skills/security-review/**)",
      "Edit(/.claude/skills/ci-cd/**)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-tool-use.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-tool-use.sh"
          }
        ]
      }
    ]
  }
}
